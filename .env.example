# Скопируйте в .env и заполните. Файл .env не коммитится.

# Токен из раздела «XML API»: https://gdeslon.ru/api_settings/xml
# Используется для поиска товаров, списка магазинов, купонов и потерянных заказов.
GDESLON_API_TOKEN=

# ID пользователя и ключ из раздела «API по продажам»: https://gdeslon.ru/api_settings/orders
# Используются для выгрузки заказов (HTTP Basic).
GDESLON_USER_ID=
GDESLON_API_KEY=


# --- Разработка (make remote-*) ---
# Linux-сервер с Docker для прогона тестов (доступ по ssh-ключу) и каталог проекта на нём.
REMOTE=
REMOTE_DIR=gdeslon-api
# Зеркало packagist, если packagist.org нестабилен из сети сервера, например https://mirrors.huaweicloud.com/repository/php/
COMPOSER_MIRROR=
